# Copy to `.env` and adjust. Used by docker-compose.
# Required:
# Set to the contract address produced by `npm run deploy:testnet` in scripts/.
# It is a C-prefixed Stellar contract address (56 chars), e.g. CCQZ7A5NZP7...
CONTRACT_ID=CCXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Optional overrides:
POSTGRES_USER=provenward
POSTGRES_PASSWORD=provenward
POSTGRES_DB=provenward
DATABASE_URL=postgresql://provenward:provenward@postgres:5432/provenward
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org:443
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
INDEXER_START_LEDGER=0
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Provenward <no-reply@provenward.local>
# Internal address the Next.js server uses to reach the API container.
BACKEND_URL_FOR_BUILD=http://backend:3001
