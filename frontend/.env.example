# Copy to `.env.local` for local development.
# Public values are embedded in the browser bundle.
# NEXT_PUBLIC_CONTRACT_ID must match the CONTRACT_ID the backend reads; it is
# produced by `npm run deploy:testnet` in scripts/.
NEXT_PUBLIC_CONTRACT_ID=CCXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org:443
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Server-side only: the internal address of the backend the Next server proxies to.
# In docker-compose this is overridden at build time via BACKEND_URL_FOR_BUILD.
BACKEND_URL=http://localhost:3001
