# Copy to `.env`. The API refuses to start without a contract id.
# Set CONTRACT_ID to the address produced by `npm run deploy:testnet` in scripts/.
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

DATABASE_URL=postgresql://provenward:provenward@localhost:5432/provenward

SOROBAN_RPC_URL=https://soroban-testnet.stellar.org:443
CONTRACT_ID=CCXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Indexer
INDEXER_POLL_INTERVAL_MS=10000
INDEXER_EVENT_LIMIT=100
INDEXER_START_LEDGER=0

# Notifier
NOTIFIER_POLL_INTERVAL_MS=30000
NOTIFIER_BATCH_SIZE=20

# Verification cache
VERIFY_CACHE_TTL_MS=60000

# Email delivery (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Provenward <no-reply@provenward.local>

LOG_LEVEL=info
